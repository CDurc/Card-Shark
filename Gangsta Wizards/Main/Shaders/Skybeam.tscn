[sub_resource type="Shader" id="Shader_4g8jr"]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back;

uniform sampler2D gradient_curve : hint_default_white;
uniform sampler2D glow_curve : hint_default_white;
uniform bool flip_gradient = false;
uniform bool flip_glow = false;
uniform vec4 color_top : source_color = vec4(1.0, 1.0, 1.0, 1.0);
uniform vec4 color_bottom : source_color = vec4(0.0, 0.0, 0.0, 0.0);
uniform float glow_strength : hint_range(0.0, 1000.0) = 1.0;
uniform float gradient_edge_blend : hint_range(0.0, 0.2) = 0.05;
uniform float glow_edge_blend : hint_range(0.0, 0.2) = 0.05;

void fragment() {
    // Clamp gradient sampling
    float gradient_y = UV.y;
    if (flip_gradient) {
        gradient_y = clamp(gradient_y, gradient_edge_blend, 1.0);
    } else {
        gradient_y = clamp(gradient_y, 0.0, 1.0 - gradient_edge_blend);
    }
    
    // Clamp glow sampling
    float glow_y = UV.y;
    if (flip_glow) {
        glow_y = clamp(glow_y, glow_edge_blend, 1.0);
    } else {
        glow_y = clamp(glow_y, 0.0, 1.0 - glow_edge_blend);
    }
    
    float gradient_sample = flip_gradient ? (1.0 - gradient_y) : gradient_y;
    float glow_sample = flip_glow ? (1.0 - glow_y) : glow_y;
    
    float blend = texture(gradient_curve, vec2(gradient_sample, 0.5)).r;
    float glow_blend = texture(glow_curve, vec2(glow_sample, 0.5)).r;
    
    vec4 final_color = mix(color_bottom, color_top, blend);
    ALBEDO = final_color.rgb;
    ALPHA = final_color.a;
    
    EMISSION = final_color.rgb * glow_strength * glow_blend;
}"

